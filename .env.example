# ─────────────────────────────────────────────────────────────
# Vellon Ops — environment template.
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored; THIS file is committed (no secrets).
# ─────────────────────────────────────────────────────────────

# --- Vellon Ops hub Supabase project (auth + hub DB) ---
# From: Supabase dashboard → your vellon-ops project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=          # "Project URL"           (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # "anon" / publishable key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=         # "service_role" secret    (SERVER ONLY — no NEXT_PUBLIC_)

# --- mgcj connector (added when we wire the first spoke; leave blank for now) ---
# MGCJ_SUPABASE_URL=
# MGCJ_SUPABASE_SERVICE_ROLE=
# MGCJ_STRIPE_SECRET=
